{
  "_comment": "Read by merge.py from the default branch only. Changing this file (including the 7a floor list) is a 7a change: the operator merges. Design: acardote/personal-assistant-ultra docs/design/merge-model.md sections 3 and 5; child issue acardote/personal-assistant-ultra#580. floor_7a is the hand-written minimum; merge.py adds paths derived transitively from derive_roots on the default branch on every run.",
  "default_branch": "main",
  "auto_merge_label": "auto-merge",
  "kill_label": "do-not-auto-merge",
  "operator_merge_label": "operator-merge",
  "merge_method": "squash",
  "verdict_config": ".github/verdict/config.json",
  "max_candidates": 50,
  "floor_7a": [
    ".github/**",
    ".claude/**",
    ".husky/**",
    ".githooks/**",
    "githooks/**",
    "templates/git-hooks/**",
    ".pre-commit-config.yaml",
    ".gitattributes",
    "**/.gitattributes",
    ".gitmodules",
    "agents/**",
    "CLAUDE.md",
    "**/CLAUDE.md",
    ".bruno/**",
    "release-policy.yaml",
    "RELEASE.md",
    "docs/policy/autonomy-v2.md",
    "docs/design/merge-model.md",
    "tools/lint-*",
    "tools/_*.py",
    "tools/install-*",
    "tools/live-commit-push.sh",
    "tools/session-spend.py",
    "tools/check-worktree*",
    "scripts/pa-session",
    "**/*close-gate*",
    "**/*close_gate*",
    "**/conftest.py",
    "tests/fixtures/**",
    "tests/test_policy_v2_sync.py",
    "tests/test_lint_agents_acceptance.py",
    "tests/test_install_agents_acceptance.py",
    "templates/routines/**",
    ".vscode/**",
    ".devcontainer/**",
    ".envrc",
    "**/package.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/pyproject.toml",
    "**/uv.lock",
    "**/poetry.lock",
    "**/requirements*.txt",
    "**/Pipfile*",
    "**/go.mod",
    "**/go.sum",
    "**/Cargo.toml",
    "**/Cargo.lock",
    "**/Gemfile*",
    "**/*lock*"
  ],
  "derive_roots": [
    ".claude/settings*.json",
    ".github/workflows/**",
    ".github/actions/**",
    ".husky/**",
    ".githooks/**",
    "githooks/**",
    "templates/git-hooks/**",
    ".pre-commit-config.yaml",
    "templates/routines/**",
    "tools/install-*",
    "tests/test_policy_v2_sync.py",
    "tests/test_lint_agents_acceptance.py",
    "tests/test_install_agents_acceptance.py",
    ".github/merge/**",
    ".github/verdict/**",
    ".vscode/tasks.json",
    ".devcontainer/**",
    ".envrc"
  ]
}
